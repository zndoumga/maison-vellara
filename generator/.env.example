# Copy to .env and fill in. Phase 1 (local mode) needs none of these.

# --- Sink selection ---
# local | cloud
SINK_MODE=local
OUTPUT_DIR=./output
STATE_DIR=./state

# --- Supabase (Source 1: boutiques) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- Firebase (Source 2: online store) ---
FIREBASE_PROJECT_ID=
# Path to service-account JSON, or the JSON itself in GOOGLE_APPLICATION_CREDENTIALS_JSON
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Azure Blob (Source 3: wholesale files) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=wholesale

# --- FastAPI (served on Render) ---
API_KEY=change-me-to-a-long-random-secret
